project Meu_Projeto_Ada is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";  -- Garante que os executáveis vão para a pasta bin

   -- Lista oficial de todos os pontos de entrada (Mains)
   for Main use ("exercicio1_analisador.adb", 
                  "exercicio2_identificadores.adb", 
                  "exercicio3_fibonacci.adb", 
                  "exercicio4_tres_enderecos.adb");

   package Compiler is
      -- -gnat2012: Usa a sintaxe moderna
      -- -gnatwa: Ativa todos os avisos (Warnings)
      -- -gnatq: Continua a compilar mesmo com erros leves
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnatq");
   end Compiler;

   package Builder is
      for Executable ("exercicio1_analisador.adb") use "ex1";
      for Executable ("exercicio2_identificadores.adb") use "ex2";
      for Executable ("exercicio3_fibonacci.adb") use "ex3";
      for Executable ("exercicio4_tres_enderecos.adb") use "ex4";
   end Builder;

end Meu_Projeto_Ada;